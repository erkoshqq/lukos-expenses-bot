# Токен Telegram-бота, полученный у @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ID Google Таблицы (из URL таблицы):
# https://docs.google.com/spreadsheets/d/ЭТОТ_ID/edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890

# Вариант 1: путь к JSON-файлу сервисного аккаунта Google (загружен рядом с ботом)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Вариант 2 (для Render.com): вставить содержимое JSON сервисного аккаунта одной строкой.
# Если задано - имеет приоритет над GOOGLE_CREDENTIALS_PATH.
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Порт для health-check эндпоинта (Render.com передаёт его автоматически через PORT)
PORT=8080
